header: Basename - migration_1_init. Extension - surql
 Migration Query: 
DEFINE FUNCTION OVERWRITE fn::get_animal_by_id($id: int) { RETURN $id } PERMISSIONS FULL;
DEFINE FUNCTION OVERWRITE fn::get_animal_by_id2($id: int) { RETURN $id } PERMISSIONS FULL;

DEFINE ANALYZER OVERWRITE ascii TOKENIZERS CLASS FILTERS LOWERCASE, ASCII, EDGENGRAM(2,15), SNOWBALL(ENGLISH);

DEFINE PARAM OVERWRITE $__some_test_param1 VALUE 'test param one' PERMISSIONS FULL;
DEFINE PARAM OVERWRITE $__some_test_param2 VALUE 'test param two' PERMISSIONS FULL;
DEFINE PARAM OVERWRITE $__some_test_param3 VALUE 'test param three' PERMISSIONS FULL;

DEFINE ACCESS OVERWRITE partner_api ON DATABASE TYPE JWT ALGORITHM RS256 KEY 'example-public-key' DURATION FOR SESSION NONE;

DEFINE TABLE OVERWRITE animal TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE TABLE OVERWRITE animal_snake_case TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE TABLE OVERWRITE crop TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE TABLE OVERWRITE eats TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE TABLE OVERWRITE eats_snake_case TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE TABLE OVERWRITE migration TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE TABLE OVERWRITE planet TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE TABLE OVERWRITE student TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;

DEFINE FIELD OVERWRITE attributes ON animal TYPE array<string> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE attributes.* ON animal TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE createdAt ON animal TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE species ON animal TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE updatedAt ON animal TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE velocity ON animal TYPE int PERMISSIONS FULL;

DEFINE FIELD OVERWRITE attributes ON animal_snake_case TYPE array<string> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE attributes.* ON animal_snake_case TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE created_at ON animal_snake_case TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE species ON animal_snake_case TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE updated_at ON animal_snake_case TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE velocity ON animal_snake_case TYPE int PERMISSIONS FULL;

DEFINE FIELD OVERWRITE color ON crop TYPE string PERMISSIONS FULL;

DEFINE FIELD OVERWRITE createdAt ON eats TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE in ON eats TYPE record PERMISSIONS FULL;
DEFINE FIELD OVERWRITE out ON eats TYPE record PERMISSIONS FULL;
DEFINE FIELD OVERWRITE place ON eats TYPE string PERMISSIONS FULL;

DEFINE FIELD OVERWRITE created_at ON eats_snake_case TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE in ON eats_snake_case TYPE record PERMISSIONS FULL;
DEFINE FIELD OVERWRITE out ON eats_snake_case TYPE record PERMISSIONS FULL;
DEFINE FIELD OVERWRITE place ON eats_snake_case TYPE string PERMISSIONS FULL;

DEFINE FIELD OVERWRITE checksum_up ON migration TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE id ON migration TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE name ON migration TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE timestamp ON migration TYPE int PERMISSIONS FULL;

DEFINE FIELD OVERWRITE createdAt ON planet TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE firstName ON planet TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE labels ON planet TYPE array<string> PERMISSIONS FULL;
DEFINE FIELD OVERWRITE labels.* ON planet TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE population ON planet TYPE int PERMISSIONS FULL;
DEFINE FIELD OVERWRITE updatedAt ON planet TYPE datetime PERMISSIONS FULL;

DEFINE FIELD OVERWRITE age ON student TYPE int PERMISSIONS FULL;
DEFINE FIELD OVERWRITE createdAt ON student TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE university ON student TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE updatedAt ON student TYPE datetime PERMISSIONS FULL;

DEFINE INDEX OVERWRITE species_speed_idx ON animal FIELDS species, velocity UNIQUE;

DEFINE EVENT OVERWRITE event1 ON animal WHEN species = 'Homo Erectus' AND velocity > 545 THEN (SELECT * FROM crop);
DEFINE EVENT OVERWRITE event2 ON animal WHEN species = 'Homo Sapien' AND velocity < 10 THEN (SELECT * FROM eats);

-- Reset the migration history
DELETE migration;

