DEFINE FUNCTION OVERWRITE fn::get_animal_by_id($id: int) { RETURN $id } PERMISSIONS FULL;
DEFINE FUNCTION OVERWRITE fn::get_animal_by_id2($id: int) { RETURN $id } PERMISSIONS FULL;

DEFINE ANALYZER OVERWRITE ascii TOKENIZERS CLASS FILTERS LOWERCASE, ASCII, EDGENGRAM(2,15), SNOWBALL(ENGLISH);

DEFINE PARAM OVERWRITE $__some_test_param1 VALUE 'test param one' PERMISSIONS FULL;
DEFINE PARAM OVERWRITE $__some_test_param2 VALUE 'test param two' PERMISSIONS FULL;
DEFINE PARAM OVERWRITE $__some_test_param3 VALUE 'test param three' PERMISSIONS FULL;

DEFINE ACCESS OVERWRITE partner_api ON DATABASE TYPE JWT ALGORITHM RS256 KEY 'example-public-key' DURATION FOR SESSION NONE;

DEFINE TABLE OVERWRITE animal TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
