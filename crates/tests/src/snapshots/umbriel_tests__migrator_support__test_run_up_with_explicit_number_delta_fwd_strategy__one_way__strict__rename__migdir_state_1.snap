header: Basename - migration_4_gen_after_init. Extension - surql
 Migration Query: 
DEFINE TABLE OVERWRITE eats_v2 TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;
DEFINE TABLE OVERWRITE new_stuff TYPE NORMAL SCHEMAFULL PERMISSIONS NONE;

-- Rename field attributes to characteristics on table animal
DEFINE FIELD OVERWRITE characteristics ON animal TYPE array<string> PERMISSIONS FULL;
UPDATE animal SET characteristics = attributes;
REMOVE FIELD attributes ON TABLE animal;
-- Rename field ending
DEFINE FIELD OVERWRITE characteristics.* ON animal TYPE string PERMISSIONS FULL;

DEFINE FIELD OVERWRITE createdAt ON eats_v2 TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE in ON eats_v2 TYPE record PERMISSIONS FULL;
DEFINE FIELD OVERWRITE location ON eats_v2 TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE out ON eats_v2 TYPE record PERMISSIONS FULL;
DEFINE FIELD OVERWRITE updatedAt ON eats_v2 TYPE datetime PERMISSIONS FULL;

DEFINE FIELD OVERWRITE createdAt ON new_stuff TYPE datetime PERMISSIONS FULL;
DEFINE FIELD OVERWRITE firstName ON new_stuff TYPE string PERMISSIONS FULL;
DEFINE FIELD OVERWRITE updatedAt ON new_stuff TYPE datetime PERMISSIONS FULL;

-- Rename field firstName to newName on table planet
DEFINE FIELD OVERWRITE newName ON planet TYPE string PERMISSIONS FULL;
UPDATE planet SET newName = firstName;
REMOVE FIELD firstName ON TABLE planet;
-- Rename field ending

DEFINE INDEX OVERWRITE species_speed_idx ON animal FIELDS velocity, characteristics UNIQUE;

DEFINE EVENT OVERWRITE event1 ON animal WHEN species = 'Homo Habillis' AND velocity > 545 THEN (SELECT * FROM crop);
REMOVE EVENT event2 ON TABLE animal;

REMOVE FIELD updatedAt ON TABLE animal;
REMOVE FIELD createdAt ON TABLE animal;
REMOVE FIELD attributes.* ON TABLE animal;

REMOVE TABLE student;
REMOVE TABLE eats_snake_case;
REMOVE TABLE eats;
REMOVE TABLE animal_snake_case;

REMOVE ACCESS partner_api ON DATABASE;

REMOVE PARAM $__some_test_param3;
REMOVE PARAM $__some_test_param2;
REMOVE PARAM $__some_test_param1;

REMOVE ANALYZER ascii;

REMOVE FUNCTION fn::get_animal_by_id2;
REMOVE FUNCTION fn::get_animal_by_id;

