REMOVE TABLE migration;
REMOVE TABLE animal;

header: Basename - migration_gen_1. Extension - up.surql
 Migration Query: 
-- Rename field attributes to characteristics on table animal
DEFINE FIELD OVERWRITE characteristics ON animal TYPE array<string> PERMISSIONS FULL;
UPDATE animal SET characteristics = attributes;
REMOVE FIELD attributes ON TABLE animal;
-- Rename field ending
DEFINE FIELD OVERWRITE characteristics.* ON animal TYPE string PERMISSIONS FULL;

-- Rename field firstName to newName on table planet
DEFINE FIELD OVERWRITE newName ON planet TYPE string PERMISSIONS FULL;
UPDATE planet SET newName = firstName;
REMOVE FIELD firstName ON TABLE planet;
-- Rename field ending

DEFINE INDEX OVERWRITE species_speed_idx ON animal FIELDS velocity, characteristics UNIQUE;

DEFINE EVENT OVERWRITE event1 ON animal WHEN species = 'Homo Habillis' AND velocity > 545 THEN (SELECT * FROM crop);
REMOVE EVENT event2 ON TABLE animal;

REMOVE FIELD updatedAt ON TABLE animal;
REMOVE FIELD createdAt ON TABLE animal;
REMOVE FIELD attributes.* ON TABLE animal;

